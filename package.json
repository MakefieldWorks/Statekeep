{
  "name": "layertrail",
  "version": "0.1.0-alpha.2",
  "description": "Local-first desktop app for structured project management",
  "author": "MakefieldWorks",
  "homepage": "https://github.com/MakefieldWorks/Layertrail",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "install-electron",
    "generate:project": "bun scripts/generate-project.mjs",
    "generate:lab": "bun scripts/generate-lab.mjs",
    "generate:brand": "python3 scripts/generate_brand_assets.py",
    "typecheck": "bun run typecheck:node && bun run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "svelte-check --tsconfig ./tsconfig.web.json",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node ./node_modules/vitest/vitest.mjs",
    "test:e2e": "bun run build && playwright test",
    "test:dogfood": "node scripts/run-dogfood.mjs",
    "package": "electron-vite build && electron-builder",
    "package:verify": "node scripts/verify_packaging.mjs",
    "package:verify:linux-desktop": "node scripts/verify_linux_desktop_integration.mjs",
    "help:update": "node scripts/update_offline_help.mjs"
  },
  "dependencies": {
    "@tanstack/svelte-virtual": "^3.13.23",
    "better-sqlite3": "^13.0.3",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "autoprefixer": "^10.4.20",
    "electron": "44.9.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^5.0.0",
    "postcss": "^8.4.47",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.6"
  },
  "trustedDependencies": [
    "electron"
  ]
}
